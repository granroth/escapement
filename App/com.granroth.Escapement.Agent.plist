<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.granroth.Escapement.Agent</string>
	<!-- Relative to the app bundle, so the agent works wherever the app lives.
	     Points into the nested helper application rather than at a bare
	     executable, so the agent has its own bundle identity. -->
	<key>BundleProgram</key>
	<string>Contents/Library/LoginItems/EscapementAgent.app/Contents/MacOS/EscapementAgent</string>
	<key>RunAtLoad</key>
	<true/>
	<!-- Deliberately unconditional. Nothing in the design needs a clean exit to
	     stick: the only deliberate stop is Turn Off, which unregisters the job
	     entirely, and Pause is a state the running agent honours. A
	     `SuccessfulExit: false` variant was tried and reverted — it bought
	     nothing and turned any stray termination into a silent, permanent stop
	     to scheduling. -->
	<key>KeepAlive</key>
	<true/>
	<key>AssociatedBundleIdentifiers</key>
	<array>
		<string>com.granroth.Escapement</string>
	</array>
</dict>
</plist>
